# Broker / account
HFM_LOGIN=12345678
HFM_PASSWORD=your_password
HFM_SERVER=HFMarketsGlobal-Demo
HFM_TERMINAL_PATH=

# Trading settings
SYMBOL=XAUUSD
TIMEFRAME=M15
MAX_RISK_PER_TRADE=0.005
MAX_DAILY_DRAWDOWN=0.03
MAX_OPEN_TRADES=2
BASE_LOT=0.01
MAGIC_NUMBER=20260330
MAX_TRADES_PER_DAY=20
MAX_CONSECUTIVE_LOSSES=4
COOLDOWN_MINUTES_AFTER_LOSS_STREAK=45
MAX_SPREAD_POINTS=80
MAX_SLIPPAGE_POINTS=20
DAILY_PROFIT_TARGET_ZAR=0
EVENT_MAX_LINES=20000
HIGHER_TIMEFRAME_CONFIRM=M5
MIN_CONFIDENCE_TREND=0.11
MIN_CONFIDENCE_RANGE=0.09
MIN_CONFIDENCE_HIGH_VOLATILITY=0.13

# Optional LLM advisor
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_INFLUENCE_ENABLED=false
GEMINI_MAX_CONFIDENCE_BOOST=0.08
GEMINI_MAX_CONFIDENCE_CUT=0.35

# Persistence
STORAGE_DIR=storage

# Live execution switch (set true to place real orders)
EXECUTE_TRADES=false

# Day-trader behavior
ENFORCE_DAY_TRADING=true

# Historical learning
ENABLE_HISTORICAL_TRAINING=true
HISTORICAL_TRAIN_MONTHS=24
HISTORICAL_TRAIN_MAX_BARS=30000
HISTORICAL_RETRAIN_HOURS=6
